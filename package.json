{
  "name": "artis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run validate:content && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "npm run validate:content && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "admin:dev": "wrangler dev --config admin-worker/wrangler.toml",
    "admin:deploy": "wrangler deploy --config admin-worker/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/afacad-flux": "5.3.0",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "astro": "7.1.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@emnapi/core": "^2.0.0-alpha.3",
    "@emnapi/runtime": "^2.0.0-alpha.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
