---
import { Image } from "astro:assets";
import AddToCartButton from "../components/AddToCartButton.astro";
import EarBlueprint from "../components/EarBlueprint.astro";
import WhatsAppLink from "../components/WhatsAppLink.astro";
import faqs from "../data/faqs.json";
import pages from "../data/pages.json";
import services from "../data/services.json";
import site from "../data/site.json";
import { hasWhatsApp, messages } from "../lib/contact";
import { withBase } from "../lib/paths";
import { getSiteImage } from "../lib/site-images";
import BaseLayout from "../layouts/BaseLayout.astro";

const publishedServices = services.filter((item) => item.published);
const service = publishedServices.find((item) => item.featured) ?? publishedServices[0];
const heroImage = getSiteImage(pages.home.heroImageFile);
const processImage = getSiteImage(pages.home.processImageFile);
const formatPrice = (amount: number) =>
  new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: service?.price.currency ?? "BRL",
    maximumFractionDigits: 0,
  }).format(amount);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.description,
  areaServed: { "@type": "Country", name: "Brasil" },
  slogan: site.tagline,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  ...(service && { priceRange: service.price.label }),
  availableLanguage: "pt-BR",
};
---

<BaseLayout structuredData={structuredData}>
  <section class="hero">
    <div class="hero__copy" data-reveal>
      <p class="eyebrow">{pages.home.heroEyebrow}</p>
      <h1 class="display">
        {pages.home.heroTitle}
        <span>{pages.home.heroTitleAccent}</span>
      </h1>
      <p class="hero__description">{pages.home.heroDescription}</p>
      <div class="hero__actions">
        <WhatsAppLink message={messages.project} label={pages.home.heroPrimaryCta} />
        <a
          class="button button--text"
          href={withBase("/servicos/design-auricular-digital-personalizado/")}
        >
          {pages.home.heroSecondaryCta}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero__note">{site.serviceArea}. {pages.home.heroNote}</p>
    </div>

    <div class="hero__visual">
      <Image
        src={heroImage}
        alt={pages.home.heroImageAlt}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 64rem) 50vw, 100vw"
        format="avif"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__blueprint">
        <EarBlueprint />
      </div>
      <div class="hero__visual-note">
        <span>{pages.home.heroVisualLabel}</span>
        <span>{pages.home.heroVisualNote}</span>
      </div>
    </div>
  </section>

  <section class="promise" aria-label="Compromissos da ARTÍS">
    {pages.home.promises.map((promise) => <p>{promise}</p>)}
  </section>

  <section class="problem section" data-reveal>
    <div class="problem__statement">
      <p class="eyebrow">{pages.home.problemEyebrow}</p>
      <h2 class="headline">{pages.home.problemTitle}</h2>
    </div>
    <div class="problem__copy">
      {pages.home.problemParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="process-visual">
    <div class="process-visual__image" data-reveal>
      <Image
        src={processImage}
        alt={pages.home.processImageAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        format="avif"
        quality={76}
      />
    </div>
    <div class="process-visual__caption" data-reveal>
      <span>01</span>
      <p>{pages.home.processCaption}</p>
    </div>
  </section>

  <section class="process section" id="como-funciona">
    <div class="process__header" data-reveal>
      <p class="eyebrow">{pages.home.processEyebrow}</p>
      <h2 class="headline">{pages.home.processTitle}</h2>
      <p class="lede">{pages.home.processDescription}</p>
    </div>
    <ol class="process__steps">
      {
        service.steps.map((step) => (
          <li data-reveal>
            <span>{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="process__action" data-reveal>
      <WhatsAppLink
        message={messages.project}
        label={pages.home.processCta}
        variant="secondary"
      />
    </div>
  </section>

  <section class="service-highlight">
    <div class="service-highlight__main" data-reveal>
      <p class="eyebrow">{service.eyebrow}</p>
      <h2 class="headline">{service.name}</h2>
      <p class="lede">{service.shortDescription}</p>
      <a class="button button--text" href={withBase(`/servicos/${service.slug}/`)}>
        {pages.home.serviceLink}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="service-highlight__price" data-reveal>
      <span>{pages.home.investmentLabel}</span>
      <strong aria-label={service.price.label}>
        <span>de</span>{" "}
        <span class="price-amount">{formatPrice(service.price.min)}</span>{" "}
        <span>a</span>{" "}
        <span class="price-amount">{formatPrice(service.price.max)}</span>
      </strong>
      <p>{service.price.note}</p>
      <div class="rule"></div>
      <p>{service.purchaseBenefit}</p>
      <AddToCartButton
        itemType="service"
        itemId={service.id}
        name={service.name}
        detail={site.onlineServiceLabel}
        priceLabel={service.price.label}
        label={pages.home.serviceCartCta}
      />
    </div>
  </section>

  <section class="curation section" data-reveal>
    <div class="curation__index" aria-hidden="true">02</div>
    <div class="curation__copy">
      <p class="eyebrow">{pages.home.curationEyebrow}</p>
      <h2 class="headline">{pages.home.curationTitle}</h2>
      <p class="lede">{pages.home.curationDescription}</p>
      <a class="button button--secondary" href={withBase("/joias/")}>
        {pages.home.curationCta}
      </a>
    </div>
    <div class="curation__object" aria-hidden="true">
      <span class="curation__ring"></span>
      <span class="curation__stone"></span>
      <svg viewBox="0 0 500 220" fill="none">
        <path d="M10 190C119 75 220 24 489 23"></path>
        <circle cx="318" cy="48" r="13"></circle>
        <circle cx="318" cy="48" r="39"></circle>
        <path d="M318 9v78M279 48h78"></path>
      </svg>
    </div>
  </section>

  <section class="manifesto" data-reveal>
    <p class="manifesto__small">{pages.home.manifestoEyebrow}</p>
    <blockquote>“{pages.home.manifestoQuote}”</blockquote>
    <p class="manifesto__signature">{site.tagline}</p>
  </section>

  <section class="faq section" id="perguntas">
    <div class="faq__header" data-reveal>
      <p class="eyebrow">{pages.home.faqEyebrow}</p>
      <h2 class="headline">{pages.home.faqTitle}</h2>
    </div>
    <div class="faq__list">
      {
        faqs.map((faq, index) => (
          <details data-reveal>
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{faq.question}</strong>
              <i aria-hidden="true" />
            </summary>
            <div>
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="contact" id="contato">
    <div class="contact__blueprint" aria-hidden="true">
      <EarBlueprint />
    </div>
    <div class="contact__copy" data-reveal>
      <p class="eyebrow">{pages.home.contactEyebrow}</p>
      <h2 class="headline">{pages.home.contactTitle}</h2>
      <p>{pages.home.contactDescription}</p>
      <WhatsAppLink message={messages.project} label={pages.home.contactCta} />
      {!hasWhatsApp && <p class="contact__pending">{pages.home.contactPending}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    width: min(100%, var(--max-width));
    margin-inline: auto;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 6vw, 5.5rem) var(--gutter);
  }

  .hero h1 {
    max-width: 11ch;
  }

  .hero h1 span {
    color: var(--color-bronze);
  }

  .hero__description {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.24rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    margin-top: 2rem;
  }

  .hero__actions > :global(.button:first-child) {
    display: none;
  }

  .hero__note {
    margin: 1.3rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .hero__visual {
    position: relative;
    min-height: 32rem;
    overflow: hidden;
    background: var(--color-linen);
  }

  .hero__visual :global(picture),
  .hero__visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__visual :global(img) {
    object-fit: cover;
    object-position: 50% 40%;
  }

  .hero__blueprint {
    position: absolute;
    right: -6rem;
    bottom: 2rem;
    width: min(75%, 31rem);
    opacity: 0.48;
    mix-blend-mode: multiply;
  }

  .hero__visual-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    color: var(--color-paper);
    font-size: 0.65rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    background: color-mix(in oklab, var(--color-graphite) 72%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-paper) 24%, transparent);
    border-radius: var(--radius-sm);
  }

  .promise {
    display: grid;
    gap: 0;
    color: var(--color-paper);
    background: var(--color-graphite);
  }

  .promise p {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    margin: 0;
    padding: 1rem var(--gutter);
    font-size: 0.83rem;
    font-weight: 550;
    border-bottom: 1px solid color-mix(in oklab, var(--color-paper) 13%, transparent);
  }

  .problem {
    display: grid;
    gap: 2rem;
  }

  .problem__copy {
    max-width: 40rem;
  }

  .problem__copy p {
    margin: 0 0 1.15rem;
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
  }

  .process-visual {
    position: relative;
    width: min(calc(100% - 2 * var(--gutter)), var(--max-width));
    margin-inline: auto;
  }

  .process-visual__image {
    min-height: 22rem;
    overflow: hidden;
    border-radius: var(--radius-image);
  }

  .process-visual__image :global(picture),
  .process-visual__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .process-visual__image :global(img) {
    object-fit: cover;
    object-position: 60% center;
  }

  .process-visual__caption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    margin: -2.5rem 1rem 0;
    padding: 1.25rem;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .process-visual__caption span {
    color: var(--color-bronze);
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
  }

  .process-visual__caption p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .process__header {
    max-width: 48rem;
  }

  .process__steps {
    padding: 0;
    margin: clamp(2.5rem, 4vw, 4rem) 0 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }

  .process__steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .process__steps li > span {
    color: var(--color-bronze);
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .process__steps h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .process__steps p {
    max-width: 37rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .process__action {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }

  .service-highlight {
    display: grid;
    color: var(--color-paper);
    background: var(--color-graphite);
  }

  .service-highlight__main,
  .service-highlight__price {
    padding: clamp(3rem, 6vw, 5rem) var(--gutter);
  }

  .service-highlight .eyebrow {
    color: var(--color-satin);
  }

  .service-highlight .lede {
    color: color-mix(in oklab, var(--color-paper) 64%, transparent);
  }

  .service-highlight .button--text {
    margin-top: 1rem;
    color: var(--color-paper);
  }

  .service-highlight__price {
    color: var(--color-graphite);
    background: var(--color-satin);
  }

  .service-highlight__price > span {
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .service-highlight__price strong {
    display: block;
    margin: 1.4rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 4rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .service-highlight__price .price-amount {
    white-space: nowrap;
  }

  .service-highlight__price p {
    max-width: 28rem;
    color: color-mix(in oklab, var(--color-graphite) 78%, transparent);
    line-height: 1.45;
  }

  .service-highlight__price .rule {
    margin-block: 2rem;
    background: color-mix(in oklab, var(--color-graphite) 24%, transparent);
  }

  .curation {
    display: grid;
    gap: 2rem;
    min-height: 32rem;
  }

  .curation__index {
    color: var(--color-satin);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
  }

  .curation__copy {
    position: relative;
    z-index: 2;
    max-width: 47rem;
  }

  .curation__copy .button {
    margin-top: 1rem;
  }

  .curation__object {
    position: relative;
    min-height: 14rem;
  }

  .curation__ring {
    position: absolute;
    top: 1rem;
    right: 10%;
    width: 6rem;
    height: 6rem;
    border: 0.8rem solid var(--color-satin);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-paper) 35%, transparent),
      0 1.5rem 3rem color-mix(in oklab, var(--color-bronze) 20%, transparent);
  }

  .curation__stone {
    position: absolute;
    top: 5.5rem;
    right: 47%;
    width: 2.6rem;
    height: 2.6rem;
    background: var(--color-paper-raised);
    border: 0.65rem solid var(--color-satin);
    border-radius: 50%;
    box-shadow: 0 1rem 2rem color-mix(in oklab, var(--color-bronze) 22%, transparent);
  }

  .curation__object svg {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 100%;
    color: var(--color-satin);
    stroke: currentColor;
    stroke-width: 1;
  }

  .manifesto {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(4rem, 8vw, 7rem) var(--gutter);
    text-align: center;
    background: var(--color-champagne);
  }

  .manifesto__small,
  .manifesto__signature {
    margin: 0;
    color: var(--color-bronze);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .manifesto blockquote {
    max-width: 19ch;
    margin: clamp(2rem, 5vw, 4rem) auto;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 430;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .faq {
    display: grid;
    gap: 2rem;
  }

  .faq__list {
    border-top: 1px solid var(--color-line-strong);
  }

  .faq details {
    border-bottom: 1px solid var(--color-line-strong);
  }

  .faq summary {
    display: grid;
    grid-template-columns: 2rem 1fr 1.5rem;
    gap: 0.75rem;
    align-items: center;
    min-height: 4.25rem;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary > span {
    color: var(--color-bronze);
    font-family: var(--font-display);
  }

  .faq summary strong {
    font-size: 1.03rem;
    font-weight: 570;
  }

  .faq summary i {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
  }

  .faq summary i::before,
  .faq summary i::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    content: "";
    background: var(--color-graphite);
    transition: transform 240ms var(--ease-out);
  }

  .faq summary i::after {
    transform: rotate(90deg);
  }

  .faq details[open] summary i::after {
    transform: rotate(0);
  }

  .faq details > div {
    display: grid;
    grid-template-rows: 1fr;
    padding: 0 2.25rem 1.6rem 2.75rem;
  }

  .faq details p {
    max-width: 48rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .contact {
    position: relative;
    display: grid;
    min-height: 30rem;
    overflow: hidden;
    background: var(--color-satin);
  }

  .contact__copy {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 55rem;
    padding: clamp(3.5rem, 7vw, 6rem) var(--gutter);
  }

  .contact__copy > p:not(.eyebrow, .contact__pending) {
    max-width: 38rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .contact__pending {
    margin: 1rem 0 0;
    font-size: 0.75rem;
  }

  .contact__blueprint {
    position: absolute;
    top: -5rem;
    right: -6rem;
    width: min(80vw, 38rem);
    opacity: 0.42;
  }

  .contact__blueprint :global(.ear-blueprint) {
    color: var(--color-graphite);
  }

  @media (min-width: 40rem) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 1.1rem;
    }

    .promise {
      grid-template-columns: repeat(3, 1fr);
    }

    .promise p {
      justify-content: center;
      text-align: center;
      border-right: 1px solid color-mix(in oklab, var(--color-paper) 13%, transparent);
      border-bottom: 0;
    }

    .promise p:last-child {
      border-right: 0;
    }
  }

  @media (min-width: 48rem) {
    .hero__actions > :global(.button:first-child) {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 1.02fr 0.98fr;
      min-height: min(44rem, calc(100svh - 5.25rem));
    }

    .hero__copy {
      padding-right: clamp(2rem, 5vw, 6rem);
    }

    .hero__visual {
      min-height: inherit;
      margin: 0 var(--gutter) 1.5rem 0;
      border-radius: 0 0 var(--radius-image) var(--radius-image);
    }

    .hero__visual-note {
      right: 1.5rem;
      bottom: 1.5rem;
      left: 1.5rem;
    }

    .problem {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }

    .problem__copy {
      justify-self: end;
    }

    .process-visual__caption {
      position: absolute;
      right: clamp(1.5rem, 5vw, 5rem);
      bottom: -2.5rem;
      grid-template-columns: auto minmax(20rem, 32rem);
      margin: 0;
      padding: 1.7rem 2rem;
    }

    .process__header {
      margin-left: 10%;
    }

    .process__steps {
      margin-left: 26%;
    }

    .process__steps li {
      grid-template-columns: 5rem 1fr;
      padding-block: 1.6rem;
    }

    .service-highlight {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .service-highlight__main {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .service-highlight__price {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .curation {
      grid-template-columns: 0.25fr 1fr 0.8fr;
      align-items: center;
    }

    .curation__object {
      min-height: 24rem;
    }

    .curation__ring {
      top: 2rem;
      right: 15%;
      width: 9rem;
      height: 9rem;
      border-width: 0.9rem;
    }

    .curation__stone {
      top: 11rem;
    }

    .faq {
      grid-template-columns: 0.65fr 1.35fr;
      gap: 4rem;
      align-items: start;
    }

    .service-highlight__price strong {
      font-size: clamp(3.5rem, 4vw, 4rem);
    }

    .manifesto blockquote {
      font-size: 3.25rem;
    }

    .faq__header {
      position: sticky;
      top: 2rem;
    }
  }
</style>
