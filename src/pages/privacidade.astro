---
import { withBase } from "../lib/paths";
import pages from "../data/pages.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={pages.privacy.metaTitle}
  description={pages.privacy.metaDescription}
  hideMobileContact
>
  <article class="legal section">
    <header>
      <p class="eyebrow">{pages.privacy.eyebrow}</p>
      <h1 class="headline">{pages.privacy.title}</h1>
      <p class="lede">{pages.privacy.description}</p>
    </header>

    {
      pages.privacy.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
        </section>
      ))
    }

    <a class="button button--secondary" href={withBase("/")}>
      {pages.privacy.backCta}
    </a>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: 68rem;
  }

  .legal header {
    margin-bottom: 4rem;
  }

  .legal section {
    display: grid;
    gap: 1rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-line-strong);
  }

  .legal h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .legal section p {
    max-width: 52rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .legal > .button {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .legal section {
      grid-template-columns: 0.6fr 1.4fr;
      gap: 3rem;
    }
  }
</style>
