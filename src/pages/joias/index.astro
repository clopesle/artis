---
import { Image } from "astro:assets";
import AddToCartButton from "../../components/AddToCartButton.astro";
import WhatsAppLink from "../../components/WhatsAppLink.astro";
import products from "../../data/products.json";
import { availabilityLabels, byEditorialPriority } from "../../lib/catalog";
import { getCatalogImage } from "../../lib/catalog-images";
import { messages } from "../../lib/contact";
import type { Product } from "../../lib/content";
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";

const publishedProducts = (products as Product[])
  .filter((product) => product.published)
  .sort(byEditorialPriority);
const preferredCategoryOrder = [
  "Argolas",
  "Labrets",
  "Topos",
  "Hastes",
  "Correntes",
  "Brincos",
];
const discoveredCategories = [
  ...new Set(publishedProducts.map((product) => product.category)),
];
const categories = [
  ...preferredCategoryOrder.filter((category) =>
    discoveredCategories.includes(category),
  ),
  ...discoveredCategories.filter(
    (category) => !preferredCategoryOrder.includes(category),
  ),
];
const categoryGroups = categories.map((category) => ({
  category,
  products: publishedProducts.filter((product) => product.category === category),
}));
---

<BaseLayout
  title="Curadoria de joias"
  description="Joias escolhidas para conversar com a anatomia, o projeto e a identidade de cada mulher."
>
  <section class="collection-hero">
    <div data-reveal>
      <p class="eyebrow">Curadoria de joias</p>
      <h1 class="display">Cada peça tem um porquê.</h1>
      <p class="lede">
        A curadoria nasce do desenho. Proporção, formato, material e brilho são
        considerados para que cada joia ocupe o lugar certo na composição.
      </p>
      <WhatsAppLink message={messages.jewelry} label="Conversar sobre joias" />
    </div>
    <div class="collection-hero__jewel" aria-hidden="true">
      <span></span>
      <i></i>
      <svg viewBox="0 0 400 400" fill="none">
        <circle cx="200" cy="200" r="145"></circle>
        <circle cx="200" cy="200" r="72"></circle>
        <path d="M200 0v400M0 200h400"></path>
      </svg>
    </div>
  </section>

  {
    publishedProducts.length > 0 ? (
      <section class="catalog section" aria-labelledby="catalogo">
        <header class="catalog__header" data-reveal>
          <div>
            <p class="eyebrow">Encontre sua peça</p>
            <h2 id="catalogo" class="headline">
              Curadoria por forma e função.
            </h2>
          </div>
          <label class="catalog__search">
            <span>Buscar joia</span>
            <input
              type="search"
              placeholder="Nome, material ou posição"
              autocomplete="off"
              data-catalog-query
            />
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m16 16 4 4" />
            </svg>
          </label>
          <fieldset class="catalog__filters" data-catalog-filters>
            <legend>Filtrar por categoria</legend>
            <button type="button" data-category="" aria-pressed="true">
              Todas
            </button>
            {categories.map((category) => (
              <button type="button" data-category={category} aria-pressed="false">
                {category}
              </button>
            ))}
          </fieldset>
          <p class="catalog__status" aria-live="polite" data-catalog-status>
            {publishedProducts.length} joias encontradas
          </p>
          <noscript>
            <p class="catalog__fallback">
              A busca e os filtros precisam de JavaScript. Todas as joias continuam
              disponíveis abaixo, organizadas por categoria.
            </p>
          </noscript>
        </header>

        <div class="catalog__groups">
          {categoryGroups.map((group) => (
            <section
              class="catalog-category"
              data-catalog-group
              data-category={group.category}
              aria-labelledby={`categoria-${group.category.toLowerCase()}`}
            >
              <header>
                <h3 id={`categoria-${group.category.toLowerCase()}`}>
                  {group.category}
                </h3>
                <span>{String(group.products.length).padStart(2, "0")}</span>
              </header>
              <div class="product-list">
                {group.products.map((product) => (
                  <article
                    data-reveal
                    data-product
                    data-search={[
                      product.name,
                      product.category,
                      product.material,
                      product.shortDescription,
                      ...product.description,
                      product.stone,
                      product.closure,
                      ...product.options,
                      ...product.suggestedPlacements,
                    ]
                      .filter(Boolean)
                      .join(" ")}
                  >
                    <a
                      class="product-list__image"
                      href={withBase(`/joias/${product.slug}/`)}
                      aria-label={`Conhecer ${product.name}`}
                    >
                      <Image
                        src={getCatalogImage(product.images[0].src)}
                        alt={product.images[0].alt}
                        widths={[480, 720, 960]}
                        sizes="(min-width: 64rem) 42vw, 100vw"
                        format="avif"
                        quality={78}
                      />
                    </a>
                    <div class="product-list__meta">
                      <span>{product.material}</span>
                      <span>{availabilityLabels[product.availability]}</span>
                    </div>
                    <h4 class="title">
                      <a href={withBase(`/joias/${product.slug}/`)}>{product.name}</a>
                    </h4>
                    <p>{product.shortDescription}</p>
                    <AddToCartButton
                      itemType="product"
                      itemId={product.id}
                      name={product.name}
                      detail={product.material}
                    />
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class="catalog__empty" data-catalog-empty hidden>
          <p class="title">Nenhuma peça encontrou esse termo.</p>
          <p>Experimente outro nome, material, posição ou categoria.</p>
        </div>
      </section>
    ) : (
      <section class="empty-catalog section" data-reveal>
        <span>Catálogo em curadoria</span>
        <div>
          <h2 class="headline">Sem peças genéricas para preencher espaço.</h2>
          <p class="lede">
            O catálogo público será aberto quando cada joia tiver informações, imagens e
            disponibilidade confirmadas. Enquanto isso, a curadoria acontece de forma
            personalizada durante o seu projeto.
          </p>
          <WhatsAppLink
            message={messages.jewelry}
            label="Pedir uma curadoria personalizada"
            variant="secondary"
          />
        </div>
      </section>
    )
  }

  <section class="jewelry-principles">
    <p>01 <span>proporção</span></p>
    <p>02 <span>material</span></p>
    <p>03 <span>harmonia</span></p>
  </section>
</BaseLayout>

<script>
  const queryInput = document.querySelector("[data-catalog-query]");
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-category]"),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-catalog-group]"),
  );
  const status = document.querySelector("[data-catalog-status]");
  const emptyState = document.querySelector<HTMLElement>("[data-catalog-empty]");
  let selectedCategory = "";

  const normalize = (value: string) =>
    value
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .toLocaleLowerCase("pt-BR")
      .trim();

  function applyCatalogFilters() {
    const query =
      queryInput instanceof HTMLInputElement ? normalize(queryInput.value) : "";
    let visibleCount = 0;

    for (const group of groups) {
      const categoryMatches =
        selectedCategory === "" || group.dataset.category === selectedCategory;
      let groupCount = 0;

      group.querySelectorAll<HTMLElement>("[data-product]").forEach((product) => {
        const queryMatches = normalize(product.dataset.search ?? "").includes(query);
        const visible = categoryMatches && queryMatches;
        product.hidden = !visible;
        if (visible) groupCount += 1;
      });

      group.hidden = groupCount === 0;
      visibleCount += groupCount;
    }

    if (status) {
      status.textContent =
        visibleCount === 1 ? "1 joia encontrada" : `${visibleCount} joias encontradas`;
    }
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  }

  queryInput?.addEventListener("input", applyCatalogFilters);

  for (const button of filterButtons) {
    button.addEventListener("click", () => {
      selectedCategory = button.dataset.category ?? "";
      filterButtons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      applyCatalogFilters();
    });
  }
</script>

<style>
  .collection-hero {
    position: relative;
    display: grid;
    min-height: 30rem;
    overflow: hidden;
    background: var(--color-champagne);
  }

  .collection-hero > div:first-child {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 58rem;
    padding: clamp(3.5rem, 7vw, 6rem) var(--gutter);
  }

  .collection-hero h1 {
    max-width: 8ch;
  }

  .collection-hero .lede {
    margin: 2rem 0;
  }

  .collection-hero__jewel {
    position: relative;
    min-height: 9rem;
  }

  .collection-hero__jewel > span {
    position: absolute;
    top: 15%;
    left: 25%;
    width: 5.5rem;
    height: 5.5rem;
    border: 0.65rem solid var(--color-satin);
    border-radius: 50%;
    box-shadow: 0 2rem 4rem color-mix(in oklab, var(--color-bronze) 20%, transparent);
  }

  .collection-hero__jewel > i {
    position: absolute;
    right: 16%;
    bottom: 20%;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--color-paper-raised);
    border: 0.5rem solid var(--color-satin);
    border-radius: 50%;
  }

  .collection-hero__jewel svg {
    position: absolute;
    right: -5rem;
    bottom: -5rem;
    width: 15rem;
    color: var(--color-bronze);
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.45;
  }

  .empty-catalog {
    display: grid;
    gap: 2rem;
  }

  .catalog__header {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .catalog__header h2 {
    max-width: 12ch;
  }

  .catalog__search {
    position: relative;
    align-self: end;
    display: grid;
    gap: 0.55rem;
  }

  .catalog__search span,
  .catalog__filters legend {
    color: var(--color-bronze);
    font-size: 0.72rem;
    font-weight: 680;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .catalog__search input {
    width: 100%;
    min-height: 3.75rem;
    padding: 0.5rem 3rem 0.5rem 0;
    color: var(--color-graphite);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-graphite);
    border-radius: 0;
    outline-offset: 0.3rem;
  }

  .catalog__search input::placeholder {
    color: var(--color-text-muted);
  }

  .catalog__search svg {
    position: absolute;
    right: 0;
    bottom: 1rem;
    width: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .catalog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0;
    border: 0;
  }

  .catalog__filters legend {
    width: 100%;
    margin-bottom: 0.55rem;
  }

  .catalog__filters button {
    min-height: 3.25rem;
    padding: 0.55rem 0.9rem;
    color: var(--color-text-muted);
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
  }

  .catalog__filters button[aria-pressed="true"] {
    color: var(--color-paper);
    background: var(--color-graphite);
    border-color: var(--color-graphite);
  }

  .catalog__status {
    margin: 0;
    color: var(--color-text-muted);
  }

  .catalog__fallback {
    margin: 0;
    color: var(--color-text-muted);
  }

  .catalog-category {
    padding-block: clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .catalog-category > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .catalog-category > header h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 6rem);
    font-weight: 440;
    letter-spacing: -0.04em;
  }

  .catalog-category > header span {
    color: var(--color-satin);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .product-list {
    display: grid;
    gap: clamp(2rem, 3vw, 3rem);
  }

  .product-list article {
    min-width: 0;
  }

  .product-list__image {
    display: block;
    aspect-ratio: 1 / 1;
    margin-bottom: 1rem;
    overflow: hidden;
    background: var(--color-linen);
    border-radius: var(--radius-image);
  }

  .product-list__image :global(picture),
  .product-list__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-list__image :global(img) {
    object-fit: cover;
    transition: transform 620ms var(--ease-out);
  }

  .product-list__image:hover :global(img) {
    transform: scale(1.025);
  }

  .product-list__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--color-bronze);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-list h4 a {
    color: inherit;
    text-decoration: none;
  }

  .product-list article > p {
    max-width: 38rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .product-list article :global(.button) {
    margin-top: 0.75rem;
  }

  .catalog__empty {
    padding-block: clamp(5rem, 10vw, 9rem);
    text-align: center;
  }

  .catalog__empty .title {
    margin-inline: auto;
  }

  .catalog__empty > p:last-child {
    color: var(--color-text-muted);
  }

  .empty-catalog > span {
    color: var(--color-bronze);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .empty-catalog > div {
    max-width: 55rem;
  }

  .empty-catalog .lede {
    margin-block: 2rem;
  }

  .jewelry-principles {
    display: grid;
    color: var(--color-paper);
    background: var(--color-graphite);
  }

  .jewelry-principles p {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    padding: 1.5rem var(--gutter);
    color: var(--color-satin);
    font-family: var(--font-display);
    font-size: 1.5rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-paper) 14%, transparent);
  }

  .jewelry-principles span {
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 64rem) {
    .collection-hero {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .collection-hero__jewel {
      min-height: 30rem;
    }

    .collection-hero__jewel > span {
      width: 8rem;
      height: 8rem;
      border-width: 0.85rem;
    }

    .collection-hero__jewel > i {
      width: 2.25rem;
      height: 2.25rem;
      border-width: 0.7rem;
    }

    .collection-hero__jewel svg {
      width: 22rem;
    }

    .empty-catalog {
      grid-template-columns: 0.5fr 1.5fr;
    }

    .product-list {
      grid-template-columns: repeat(3, 1fr);
    }

    .product-list article:nth-child(even) {
      padding-top: 0;
    }

    .catalog__header {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .catalog__filters,
    .catalog__status {
      grid-column: 1 / -1;
    }

    .jewelry-principles {
      grid-template-columns: repeat(3, 1fr);
    }

    .jewelry-principles p {
      border-right: 1px solid color-mix(in oklab, var(--color-paper) 14%, transparent);
      border-bottom: 0;
    }
  }
</style>
