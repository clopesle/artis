---
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import AddToCartButton from "../../components/AddToCartButton.astro";
import WhatsAppLink from "../../components/WhatsAppLink.astro";
import { availabilityLabels } from "../../lib/catalog";
import { getCatalogImage } from "../../lib/catalog-images";
import { messages } from "../../lib/contact";
import type { Product } from "../../lib/content";
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const { default: productsData } = await import("../../data/products.json");
  const products = productsData as Product[];

  return products
    .filter((product) => product.published)
    .map((product) => ({
      params: { slug: product.slug },
      props: { product },
    }));
}) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const message = `${messages.jewelry} Tenho interesse em: ${product.name}.`;
const productImages = product.images.map((image) => ({
  ...image,
  metadata: getCatalogImage(image.src),
}));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.shortDescription,
  image: productImages.map(
    ({ metadata }) =>
      new URL(
        `${import.meta.env.BASE_URL}${metadata.src.replace(/^\/+/, "")}`,
        Astro.site,
      ).href,
  ),
  material: product.material,
  category: product.category,
};
---

<BaseLayout
  title={product.name}
  description={product.shortDescription}
  structuredData={structuredData}
>
  <article class="product-detail">
    <div class="product-detail__gallery" data-reveal>
      {
        productImages.map((image, index) => (
          <Image
            src={image.metadata}
            alt={image.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 64rem) 52vw, 100vw"
            format="avif"
            quality={80}
            loading={index === 0 ? "eager" : "lazy"}
          />
        ))
      }
    </div>
    <div class="product-detail__copy" data-reveal>
      <a class="product-detail__back" href={withBase("/joias/")}>
        ← Voltar para joias
      </a>
      <p class="eyebrow">{product.category}</p>
      <h1 class="display">{product.name}</h1>
      <p class="lede">{product.shortDescription}</p>

      <dl>
        <div>
          <dt>Material</dt>
          <dd>{product.material}</dd>
        </div>
        <div>
          <dt>Disponibilidade</dt>
          <dd>{availabilityLabels[product.availability]}</dd>
        </div>
        <div>
          <dt>Fecho</dt>
          <dd>{product.closure}</dd>
        </div>
        {
          product.stone && (
            <div>
              <dt>Pedra</dt>
              <dd>{product.stone}</dd>
            </div>
          )
        }
      </dl>

      {
        product.description.map((paragraph) => (
          <p class="product-detail__description">{paragraph}</p>
        ))
      }

      <section class="product-detail__options" aria-labelledby="opcoes">
        <h2 id="opcoes">Opções para consulta</h2>
        <ul>
          {product.options.map((option) => <li>{option}</li>)}
        </ul>
        <p>
          Posições sugeridas: {product.suggestedPlacements.join(", ")}. A medida final
          depende da anatomia e da avaliação profissional.
        </p>
      </section>

      {
        product.availability !== "indisponivel" && (
          <div class="product-detail__actions">
            <AddToCartButton
              itemType="product"
              itemId={product.id}
              name={product.name}
              detail={product.material}
              variant="primary"
            />
            <WhatsAppLink
              message={message}
              label="Consultar esta joia"
              variant="secondary"
            />
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .product-detail {
    display: grid;
    min-height: calc(100svh - 6.75rem);
  }

  .product-detail__gallery {
    display: grid;
    min-height: 38rem;
    background: var(--color-linen);
  }

  .product-detail__gallery :global(picture),
  .product-detail__gallery :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-detail__gallery :global(img) {
    min-height: 38rem;
    max-height: 52rem;
    object-fit: cover;
  }

  .product-detail__copy {
    align-self: center;
    padding: clamp(4rem, 9vw, 8rem) var(--gutter);
  }

  .product-detail__back {
    display: inline-block;
    margin-bottom: 3rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .product-detail h1 {
    max-width: 8ch;
  }

  .product-detail .lede {
    margin-block: 2rem;
  }

  .product-detail dl {
    margin: 0 0 2rem;
    border-top: 1px solid var(--color-line-strong);
  }

  .product-detail dl > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .product-detail dt {
    color: var(--color-text-muted);
  }

  .product-detail dd {
    margin: 0;
  }

  .product-detail__description {
    max-width: 42rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .product-detail__options {
    max-width: 42rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-strong);
  }

  .product-detail__options h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 450;
  }

  .product-detail__options ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .product-detail__options li {
    padding: 0.45rem 0.75rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
  }

  .product-detail__options p {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .product-detail :global(.button) {
    margin-top: 1.5rem;
  }

  .product-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .product-detail {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
