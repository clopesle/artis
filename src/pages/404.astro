---
import { withBase } from "../lib/paths";
import pages from "../data/pages.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={pages.notFound.metaTitle}
  description={pages.notFound.metaDescription}
  hideMobileContact
  noIndex
>
  <section class="not-found">
    <span aria-hidden="true">404</span>
    <div>
      <p class="eyebrow">{pages.notFound.eyebrow}</p>
      <h1 class="headline">{pages.notFound.title}</h1>
      <a class="button" href={withBase("/")}>{pages.notFound.backCta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 70svh;
    padding: 5rem var(--gutter);
    overflow: hidden;
    text-align: center;
  }

  .not-found > span {
    position: absolute;
    color: var(--color-champagne);
    font-family: var(--font-display);
    font-size: clamp(9rem, 32vw, 24rem);
    line-height: 0.7;
  }

  .not-found > div {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found h1 {
    max-width: 10ch;
    margin-bottom: 2rem;
  }
</style>
