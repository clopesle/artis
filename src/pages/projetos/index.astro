---
import { Image } from "astro:assets";
import EarBlueprint from "../../components/EarBlueprint.astro";
import WhatsAppLink from "../../components/WhatsAppLink.astro";
import projects from "../../data/projects.json";
import { byEditorialPriority } from "../../lib/catalog";
import { getCatalogImage } from "../../lib/catalog-images";
import { messages } from "../../lib/contact";
import type { Project } from "../../lib/content";
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";

const publishedProjects = (projects as Project[])
  .filter((project) => project.published)
  .sort(byEditorialPriority);
---

<BaseLayout
  title="Projetos auriculares"
  description="Conheça projetos de Design Auricular Digital desenvolvidos pela ARTÍS e publicados com autorização."
>
  <section class="projects-hero">
    <div class="projects-hero__copy" data-reveal>
      <p class="eyebrow">Projetos ARTÍS</p>
      <h1 class="display">Nenhuma orelha pede a mesma resposta.</h1>
      <p class="lede">
        Cada projeto nasce de uma conversa diferente. O portfólio reúne apenas trabalhos
        reais publicados com autorização.
      </p>
    </div>
    <div class="projects-hero__mark" aria-hidden="true">
      <EarBlueprint />
    </div>
  </section>

  {
    publishedProjects.length > 0 ? (
      <section class="projects-list section">
        {publishedProjects.map((project) => (
          <article data-reveal data-featured={project.featured || undefined}>
            <a
              class="projects-list__image"
              href={withBase(`/projetos/${project.slug}/`)}
              aria-label={`Conhecer o projeto ${project.title}`}
            >
              <Image
                src={getCatalogImage(project.image)}
                alt={project.imageAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 42vw, 100vw"
                format="avif"
                quality={78}
              />
            </a>
            <p>{project.categories.join(" • ")}</p>
            <h2 class="title">
              <a href={withBase(`/projetos/${project.slug}/`)}>{project.title}</a>
            </h2>
            <p>{project.shortDescription}</p>
          </article>
        ))}
      </section>
    ) : (
      <section class="portfolio-pending section" data-reveal>
        <span>Portfólio em preparação</span>
        <div>
          <h2 class="headline">Projetos reais pedem contexto e autorização.</h2>
          <p class="lede">
            Estamos preparando os primeiros casos com o cuidado que eles merecem.
            Nenhuma imagem ou história será publicada apenas para preencher esta página.
          </p>
          <WhatsAppLink
            message={messages.portfolio}
            label="Quero criar meu projeto"
            variant="secondary"
          />
        </div>
      </section>
    )
  }

  <section class="project-principle">
    <p>
      A composição ideal não é a que tem mais joias. É a que parece ter nascido para
      você.
    </p>
  </section>
</BaseLayout>

<style>
  .projects-hero {
    position: relative;
    min-height: 30rem;
    overflow: hidden;
    color: var(--color-paper);
    background: var(--color-graphite);
  }

  .projects-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 70rem;
    padding: clamp(3.5rem, 7vw, 6rem) var(--gutter);
  }

  .projects-hero h1 {
    max-width: 10ch;
  }

  .projects-hero .lede {
    margin-top: 2rem;
    color: color-mix(in oklab, var(--color-paper) 65%, transparent);
  }

  .projects-hero .eyebrow {
    color: var(--color-satin);
  }

  .projects-hero__mark {
    position: absolute;
    right: -5rem;
    bottom: -10rem;
    width: min(70vw, 30rem);
    opacity: 0.28;
  }

  .portfolio-pending {
    display: grid;
    gap: 2rem;
  }

  .projects-list {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .projects-list__image {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-linen);
    border-radius: var(--radius-image);
  }

  .projects-list__image :global(picture),
  .projects-list__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .projects-list__image :global(img) {
    object-fit: cover;
    transition: transform 620ms var(--ease-out);
  }

  .projects-list__image:hover :global(img) {
    transform: scale(1.025);
  }

  .projects-list article > p:first-of-type {
    margin: 1.2rem 0 0.8rem;
    color: var(--color-bronze);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects-list h2 a {
    color: inherit;
    text-decoration: none;
  }

  .projects-list article > p:last-child {
    max-width: 38rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .portfolio-pending > span {
    color: var(--color-bronze);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portfolio-pending > div {
    max-width: 58rem;
  }

  .portfolio-pending .lede {
    margin-block: 2rem;
  }

  .project-principle {
    padding: clamp(4rem, 8vw, 7rem) var(--gutter);
    background: var(--color-champagne);
  }

  .project-principle p {
    max-width: 20ch;
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .portfolio-pending {
      grid-template-columns: 0.5fr 1.5fr;
    }

    .projects-list {
      grid-template-columns: repeat(3, 1fr);
    }

    .projects-list article:nth-child(even) {
      padding-top: 0;
    }

    .project-principle p {
      font-size: 3.25rem;
    }
  }
</style>
