---
const bridgeUrl = import.meta.env.PUBLIC_ADMIN_BRIDGE_URL ?? "";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f5f3ef" />
    <title>Administração — ARTÍS</title>
    <style is:global>
      :root {
        color-scheme: light;
        --paper: #f5f3ef;
        --surface: #fff;
        --surface-soft: #ece9e3;
        --ink: #211c18;
        --muted: #6f6861;
        --line: #d8d3cb;
        --accent: #795d42;
        --accent-soft: #eee4da;
        --danger: #a23b35;
        --success: #286345;
        --shadow: 0 12px 32px rgb(39 32 26 / 8%);
        font-family:
          Inter,
          ui-sans-serif,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-size: 15px;
        line-height: 1.45;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button:focus-visible,
      a:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
        outline: 3px solid rgb(121 93 66 / 28%);
        outline-offset: 2px;
      }

      [hidden] {
        display: none !important;
      }

      .auth-screen {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .auth-card {
        width: min(440px, 100%);
        padding: 40px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: var(--shadow);
      }

      .brand {
        margin: 0 0 32px;
        font-size: 17px;
        font-weight: 750;
        letter-spacing: 0.2em;
      }

      .auth-card h1 {
        margin: 0;
        font-size: 28px;
        line-height: 1.15;
        letter-spacing: -0.025em;
      }

      .auth-card p {
        margin: 12px 0 24px;
        color: var(--muted);
      }

      .button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border: 1px solid var(--ink);
        border-radius: 9px;
        background: var(--ink);
        color: #fff;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
      }

      .button:hover {
        opacity: 0.88;
      }

      .button.secondary {
        border-color: var(--line);
        background: var(--surface);
        color: var(--ink);
      }

      .button.danger {
        border-color: #e3c4c1;
        background: #fff8f7;
        color: var(--danger);
      }

      .button.small {
        min-height: 34px;
        padding: 6px 10px;
        font-size: 13px;
      }

      .button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .app {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 236px minmax(0, 1fr);
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 24px 16px;
        border-right: 1px solid var(--line);
        background: #efede8;
        overflow-y: auto;
      }

      .sidebar .brand {
        margin: 4px 12px 24px;
      }

      .nav-label {
        margin: 20px 12px 7px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .nav-button {
        width: 100%;
        min-height: 40px;
        padding: 8px 12px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--ink);
        text-align: left;
        cursor: pointer;
      }

      .nav-button:hover {
        background: rgb(255 255 255 / 62%);
      }

      .nav-button[aria-current="page"] {
        background: var(--surface);
        box-shadow: 0 1px 4px rgb(39 32 26 / 8%);
        font-weight: 650;
      }

      .sidebar-footer {
        margin: 28px 12px 0;
        padding-top: 18px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 12px;
      }

      .sidebar-footer strong {
        display: block;
        overflow: hidden;
        color: var(--ink);
        text-overflow: ellipsis;
      }

      .text-button {
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--accent);
        cursor: pointer;
      }

      .main {
        min-width: 0;
      }

      .topbar {
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 12px 28px;
        border-bottom: 1px solid var(--line);
        background: rgb(245 243 239 / 94%);
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
      }

      .topbar h1 {
        margin: 0;
        font-size: 20px;
        letter-spacing: -0.015em;
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .save-state {
        color: var(--muted);
        font-size: 13px;
      }

      .workspace {
        width: min(1180px, 100%);
        padding: 28px;
      }

      .section-intro {
        margin-bottom: 22px;
      }

      .section-intro h2 {
        margin: 0;
        font-size: 24px;
        letter-spacing: -0.025em;
      }

      .section-intro p {
        max-width: 680px;
        margin: 7px 0 0;
        color: var(--muted);
      }

      .editor-layout {
        display: grid;
        grid-template-columns: minmax(210px, 280px) minmax(0, 720px);
        gap: 20px;
        align-items: start;
      }

      .collection-panel,
      .editor-panel,
      .panel {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        box-shadow: 0 3px 14px rgb(39 32 26 / 4%);
      }

      .collection-panel {
        padding: 8px;
      }

      .collection-item {
        width: 100%;
        padding: 10px;
        border: 0;
        border-radius: 7px;
        background: transparent;
        text-align: left;
        cursor: pointer;
      }

      .collection-item:hover {
        background: var(--surface-soft);
      }

      .collection-item[aria-current="true"] {
        background: var(--accent-soft);
      }

      .collection-item strong,
      .collection-item span {
        display: block;
      }

      .collection-item span {
        margin-top: 2px;
        color: var(--muted);
        font-size: 12px;
      }

      .collection-actions {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        padding: 8px 4px 4px;
      }

      .editor-panel,
      .panel {
        padding: 22px;
      }

      .fields {
        display: grid;
        gap: 18px;
      }

      .field {
        min-width: 0;
      }

      .field > label,
      .field-label {
        display: block;
        margin: 0 0 6px;
        color: #4e4842;
        font-size: 13px;
        font-weight: 650;
      }

      .field-help {
        display: block;
        margin-top: 5px;
        color: var(--muted);
        font-size: 12px;
      }

      input:not([type="checkbox"]):not([type="file"]),
      textarea,
      select {
        width: 100%;
        min-height: 40px;
        padding: 9px 11px;
        border: 1px solid #c9c3bb;
        border-radius: 7px;
        background: #fff;
        color: var(--ink);
      }

      textarea {
        min-height: 92px;
        resize: vertical;
      }

      input:focus,
      textarea:focus,
      select:focus {
        border-color: var(--accent);
      }

      .checkbox {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .checkbox input {
        width: 17px;
        height: 17px;
        accent-color: var(--accent);
      }

      fieldset {
        min-width: 0;
        margin: 0;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 9px;
      }

      legend {
        padding: 0 6px;
        color: #4e4842;
        font-size: 13px;
        font-weight: 700;
      }

      .nested-list {
        display: grid;
        gap: 10px;
      }

      .nested-card {
        position: relative;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #faf9f7;
      }

      .nested-card .fields {
        padding-right: 34px;
      }

      .remove-nested {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 28px;
        height: 28px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--danger);
        cursor: pointer;
      }

      .empty {
        padding: 34px 18px;
        color: var(--muted);
        text-align: center;
      }

      .notice {
        margin-bottom: 18px;
        padding: 11px 13px;
        border: 1px solid #d8c9b7;
        border-radius: 8px;
        background: #fbf5ed;
        color: #654e37;
      }

      .notice.error {
        border-color: #e3c4c1;
        background: #fff5f4;
        color: var(--danger);
      }

      .notice.success {
        border-color: #bdd9c9;
        background: #f2faf5;
        color: var(--success);
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 18px;
      }

      .search-form {
        display: grid;
        grid-template-columns: minmax(180px, 240px) minmax(220px, 1fr) auto;
        gap: 10px;
        margin-bottom: 24px;
      }

      .candidate-grid,
      .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 14px;
      }

      .candidate,
      .image-card {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
      }

      .candidate img,
      .image-card img {
        width: 100%;
        aspect-ratio: 1;
        display: block;
        object-fit: contain;
        background: #fff;
      }

      .candidate-body,
      .image-card-body {
        padding: 13px;
      }

      .candidate h3,
      .image-card strong {
        margin: 0 0 5px;
        font-size: 15px;
      }

      .candidate p {
        margin: 5px 0 12px;
        color: var(--muted);
        font-size: 13px;
      }

      .badge {
        display: inline-flex;
        padding: 3px 7px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: #654e37;
        font-size: 11px;
        font-weight: 700;
      }

      .badge.ineligible {
        background: #f0ece8;
        color: var(--muted);
      }

      .image-card-body {
        display: grid;
        gap: 8px;
      }

      .image-card small {
        overflow-wrap: anywhere;
        color: var(--muted);
      }

      .loading {
        min-height: 220px;
        display: grid;
        place-items: center;
        color: var(--muted);
      }

      .review-dialog {
        width: min(880px, calc(100% - 32px));
        max-height: calc(100svh - 32px);
        padding: 24px;
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        color: var(--ink);
      }

      .review-dialog::backdrop {
        background: rgb(33 28 24 / 58%);
        backdrop-filter: blur(3px);
      }

      .review-dialog__header h2 {
        margin: 2px 0 6px;
        font-size: 22px;
      }

      .review-dialog__header p {
        margin: 0 0 18px;
        color: var(--muted);
      }

      .review-dialog > img {
        width: min(260px, 100%);
        aspect-ratio: 1;
        display: block;
        margin: 0 0 22px;
        object-fit: contain;
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .review-dialog__actions {
        position: sticky;
        bottom: -24px;
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        margin: 24px -24px -24px;
        padding: 16px 24px;
        border-top: 1px solid var(--line);
        background: var(--surface);
      }

      .mobile-nav {
        display: none;
      }

      @media (max-width: 820px) {
        .app {
          display: block;
        }

        .sidebar {
          display: none;
        }

        .topbar {
          padding: 10px 16px;
        }

        .topbar h1 {
          display: none;
        }

        .save-state {
          display: none;
        }

        .workspace {
          padding: 18px 16px 96px;
        }

        .mobile-nav {
          display: block;
          width: 100%;
          min-height: 40px;
          padding: 8px 10px;
          border: 1px solid var(--line);
          border-radius: 8px;
          background: var(--surface);
        }

        .editor-layout {
          grid-template-columns: 1fr;
        }

        .collection-panel {
          max-height: 240px;
          overflow-y: auto;
        }

        .search-form {
          grid-template-columns: 1fr;
        }

        .candidate-grid,
        .image-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .auth-card {
          padding: 28px 22px;
        }

        .review-dialog__actions {
          flex-direction: column-reverse;
        }
      }

      @media (max-width: 520px) {
        .candidate-grid,
        .image-grid {
          grid-template-columns: 1fr;
        }

        .editor-panel,
        .panel {
          padding: 16px;
        }

        .topbar-actions .secondary {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main id="admin-root" data-bridge-url={bridgeUrl}>
      <section id="auth-screen" class="auth-screen">
        <div class="auth-card">
          <p class="brand">ARTÍS</p>
          <h1>Administração do site</h1>
          <p id="auth-message">
            Entre com uma conta GitHub que tenha permissão de escrita neste repositório.
          </p>
          <a id="login-button" class="button" href="#">Entrar com o GitHub</a>
        </div>
      </section>

      <section id="admin-app" class="app" hidden>
        <aside class="sidebar">
          <p class="brand">ARTÍS</p>
          <p class="nav-label">Conteúdo</p>
          <nav id="desktop-nav" aria-label="Áreas administrativas"></nav>
          <div class="sidebar-footer">
            <strong id="user-name">—</strong>
            <span id="repository-name">—</span><br />
            <button id="logout-button" class="text-button" type="button">Sair</button>
          </div>
        </aside>

        <div class="main">
          <header class="topbar">
            <div>
              <select
                id="mobile-nav"
                class="mobile-nav"
                aria-label="Escolher área administrativa"></select>
              <h1 id="page-title">Conteúdo do site</h1>
            </div>
            <div class="topbar-actions">
              <span id="save-state" class="save-state" aria-live="polite"></span>
              <a class="button secondary small" href="../" target="_blank">Ver site</a>
              <button id="save-button" class="button small" type="button" hidden>
                Salvar alterações
              </button>
            </div>
          </header>

          <div id="workspace" class="workspace">
            <div class="loading">Carregando conteúdo…</div>
          </div>
        </div>
      </section>
    </main>
    <script src="../../scripts/admin.ts"></script>
  </body>
</html>
