---
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import AddToCartButton from "../../components/AddToCartButton.astro";
import EarBlueprint from "../../components/EarBlueprint.astro";
import WhatsAppLink from "../../components/WhatsAppLink.astro";
import processImage from "../../assets/processo-artis.png";
import pages from "../../data/pages.json";
import site from "../../data/site.json";
import services from "../../data/services.json";
import { messages } from "../../lib/contact";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  services
    .filter((service) => service.published)
    .map((service) => ({
      params: { slug: service.slug },
      props: { service },
    }))) satisfies GetStaticPaths;

type Service = (typeof services)[number];
const { service } = Astro.props as { service: Service };
const formatPrice = (amount: number) =>
  new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: service.price.currency,
    maximumFractionDigits: 0,
  }).format(amount);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.shortDescription,
  provider: {
    "@type": "ProfessionalService",
    name: "ARTÍS",
  },
  areaServed: { "@type": "Country", name: "Brasil" },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: service.price.currency,
    lowPrice: service.price.min,
    highPrice: service.price.max,
    availability: "https://schema.org/InStock",
  },
};
---

<BaseLayout
  title={service.name}
  description={`${service.shortDescription} ${site.serviceArea}.`}
  structuredData={structuredData}
>
  <section class="service-hero">
    <div class="service-hero__copy" data-reveal>
      <p class="eyebrow">{service.eyebrow}</p>
      <h1 class="display">{service.name}</h1>
      <p class="lede">{service.shortDescription}</p>
      <WhatsAppLink message={messages.project} label={pages.serviceDetail.heroCta} />
    </div>
    <div class="service-hero__mark" aria-hidden="true">
      <EarBlueprint />
    </div>
  </section>

  <section class="service-intro section">
    <div class="service-intro__number" aria-hidden="true">01</div>
    <div data-reveal>
      {service.description.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="service-image" data-reveal>
    <Image
      src={processImage}
      alt={pages.serviceDetail.imageAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      format="avif"
      quality={76}
    />
  </section>

  <section class="included section">
    <div class="included__heading" data-reveal>
      <p class="eyebrow">{pages.serviceDetail.includedEyebrow}</p>
      <h2 class="headline">{pages.serviceDetail.includedTitle}</h2>
    </div>
    <ol>
      {
        service.included.map((item, index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{item}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="investment">
    <div class="investment__label">
      <p>{pages.serviceDetail.investmentLabel}</p>
    </div>
    <div class="investment__value" data-reveal>
      <strong aria-label={service.price.label}>
        <span>de</span>{" "}
        <span class="price-amount">{formatPrice(service.price.min)}</span>{" "}
        <span>a</span>{" "}
        <span class="price-amount">{formatPrice(service.price.max)}</span>
      </strong>
      <p>{service.price.note}</p>
    </div>
    <div class="investment__benefit" data-reveal>
      <p>{service.purchaseBenefit}</p>
      <WhatsAppLink
        message={messages.project}
        label={pages.serviceDetail.contactCta}
        variant="secondary"
      />
      <AddToCartButton
        itemType="service"
        itemId={service.id}
        name={service.name}
        detail={site.onlineServiceLabel}
        priceLabel={service.price.label}
        label={pages.serviceDetail.cartCta}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    display: grid;
    min-height: 30rem;
    overflow: hidden;
    color: var(--color-paper);
    background: var(--color-graphite);
  }

  .service-hero__copy {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 68rem;
    padding: clamp(3.5rem, 7vw, 6rem) var(--gutter);
  }

  .service-hero__copy h1 {
    max-width: 9ch;
  }

  .service-hero__copy .lede {
    margin: 2rem 0;
    color: color-mix(in oklab, var(--color-paper) 68%, transparent);
  }

  .service-hero__copy .eyebrow {
    color: var(--color-satin);
  }

  .service-hero__copy :global(.button) {
    color: var(--color-graphite);
    background: var(--color-satin);
    border-color: var(--color-satin);
  }

  .service-hero__mark {
    position: absolute;
    right: -6rem;
    bottom: -8rem;
    width: min(70vw, 32rem);
    opacity: 0.28;
  }

  .service-intro {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
  }

  .service-intro__number {
    color: var(--color-satin);
    font-family: var(--font-display);
    font-size: 3rem;
  }

  .service-intro p {
    max-width: 55rem;
    margin: 0 0 1.2rem;
    color: var(--color-text-muted);
    font-size: clamp(1.18rem, 2.2vw, 1.6rem);
    line-height: 1.5;
  }

  .service-image {
    width: min(calc(100% - 2 * var(--gutter)), var(--max-width));
    max-height: 40rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-image);
  }

  .service-image :global(picture),
  .service-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .service-image :global(img) {
    object-fit: cover;
  }

  .included {
    display: grid;
    gap: 2rem;
  }

  .included ol {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }

  .included li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .included li span {
    color: var(--color-bronze);
    font-family: var(--font-display);
  }

  .included li p {
    margin: 0;
    font-size: 1.05rem;
  }

  .investment {
    display: grid;
    background: var(--color-satin);
  }

  .investment > div {
    padding: clamp(1.75rem, 3vw, 3rem) var(--gutter);
    border-bottom: 1px solid color-mix(in oklab, var(--color-graphite) 20%, transparent);
  }

  .investment__label p,
  .investment__benefit p {
    max-width: 34rem;
    margin: 0;
    line-height: 1.5;
  }

  .investment__value strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 4rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .investment__value .price-amount {
    white-space: nowrap;
  }

  .investment__value p {
    margin: 1rem 0 0;
  }

  .investment__benefit :global(.button) {
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .service-intro {
      grid-template-columns: 0.45fr 1.55fr;
    }

    .service-intro__number {
      font-size: 3.75rem;
    }

    .included {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }

    .investment {
      grid-template-columns: 0.5fr 1fr 0.8fr;
    }

    .investment__value strong {
      font-size: 4rem;
    }

    .investment > div {
      border-right: 1px solid
        color-mix(in oklab, var(--color-graphite) 20%, transparent);
      border-bottom: 0;
    }
  }
</style>
