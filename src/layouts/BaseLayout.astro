---
import "@fontsource-variable/afacad-flux";
import "@fontsource-variable/bodoni-moda";
import heroImage from "../assets/hero-artis.png";
import site from "../data/site.json";
import "../styles/global.css";
import MobileContactBar from "../components/MobileContactBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  hideMobileContact?: boolean;
  noIndex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  hideMobileContact = false,
  noIndex = false,
  structuredData,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(heroImage.src, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="theme-color" content="#f7f2e9" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
      type="image/svg+xml"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta
      property="og:image:alt"
      content="Composição auricular delicada criada pela ARTÍS"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{pageTitle}</title>
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
    {!hideMobileContact && <MobileContactBar />}

    <script>
      import {
        CART_STORAGE_KEY,
        addCartItem,
        cartItemCount,
        deserializeCart,
        serializeCart,
        type CartItem,
      } from "../lib/cart";

      function readCart() {
        try {
          return deserializeCart(localStorage.getItem(CART_STORAGE_KEY));
        } catch {
          return [];
        }
      }

      function writeCart(items: CartItem[]) {
        try {
          localStorage.setItem(CART_STORAGE_KEY, serializeCart(items));
        } catch {
          // The current page still works when browser storage is unavailable.
        }

        window.dispatchEvent(new CustomEvent("artis:cart-updated", { detail: items }));
      }

      function refreshCartCount(items = readCart()) {
        const count = cartItemCount(items);

        document.querySelectorAll("[data-cart-count]").forEach((element) => {
          element.textContent = String(count);
          element.toggleAttribute("data-empty", count === 0);
        });
      }

      refreshCartCount();
      window.addEventListener("artis:cart-updated", (event) => {
        refreshCartCount((event as CustomEvent<CartItem[]>).detail);
      });

      document.querySelectorAll("[data-cart-add]").forEach((element) => {
        if (!(element instanceof HTMLButtonElement)) return;

        element.addEventListener("click", () => {
          const encodedItem = element.dataset.cartItem;
          if (!encodedItem) return;

          const item = JSON.parse(encodedItem) as CartItem;
          writeCart(addCartItem(readCart(), item));

          const label = element.querySelector("[data-cart-button-label]");
          const defaultLabel = element.dataset.defaultLabel ?? "Adicionar à sacola";

          if (label) label.textContent = "Adicionado";
          element.setAttribute("aria-label", `${item.name} adicionado à sacola`);

          window.setTimeout(() => {
            if (label) label.textContent = defaultLabel;
            element.removeAttribute("aria-label");
          }, 1600);
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.setAttribute("data-visible", "");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
      );

      document
        .querySelectorAll("[data-reveal]")
        .forEach((element) => observer.observe(element));

      document.querySelectorAll(".site-header__menu-panel a").forEach((link) => {
        link.addEventListener("click", () => {
          link.closest("details")?.removeAttribute("open");
        });
      });
    </script>
  </body>
</html>
