---
import site from "../data/site.json";
import { messages } from "../lib/contact";
import { withBase } from "../lib/paths";
import WhatsAppLink from "./WhatsAppLink.astro";
import Wordmark from "./Wordmark.astro";

const currentPath = Astro.url.pathname;
const links = [
  { href: withBase("/"), label: "Início" },
  {
    href: withBase("/servicos/design-auricular-digital-personalizado/"),
    label: "Design Auricular",
  },
  { href: withBase("/joias/"), label: "Joias" },
  { href: withBase("/projetos/"), label: "Projetos" },
];
---

{
  site.announcement.enabled && (
    <aside class="site-announcement" aria-label="Aviso">
      <p>{site.announcement.text}</p>
      {site.announcement.href && site.announcement.linkLabel && (
        <a href={withBase(site.announcement.href)}>{site.announcement.linkLabel}</a>
      )}
    </aside>
  )
}

<header class="site-header" data-site-header>
  <a class="site-header__brand" href={withBase("/")} aria-label="ARTÍS, página inicial">
    <Wordmark />
  </a>

  <nav class="site-header__desktop-nav" aria-label="Navegação principal">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="site-header__desktop-cta">
    <WhatsAppLink
      message={messages.project}
      label="Começar meu projeto"
      variant="secondary"
    />
  </div>

  <details class="site-header__menu">
    <summary aria-label="Abrir menu">
      <span></span>
      <span></span>
    </summary>
    <div class="site-header__menu-panel">
      <nav aria-label="Navegação para dispositivos móveis">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <WhatsAppLink message={messages.project} label="Começar meu projeto" />
      <p>Atendimento online para todo o Brasil.</p>
    </div>
  </details>
</header>

<style>
  .site-announcement {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1rem;
    padding: 0.65rem var(--gutter);
    color: var(--color-paper);
    font-size: 0.84rem;
    text-align: center;
    background: var(--color-graphite);
  }

  .site-announcement p {
    margin: 0;
  }

  .site-announcement a {
    color: var(--color-satin);
    font-weight: 650;
  }

  .site-header {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    min-height: 5.75rem;
    padding: 1rem var(--gutter);
    color: var(--color-graphite);
    background: color-mix(in oklab, var(--color-paper) 92%, transparent);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__brand {
    position: relative;
    z-index: 22;
    width: max-content;
    color: inherit;
    text-decoration: none;
  }

  .site-header__desktop-nav,
  .site-header__desktop-cta {
    display: none;
  }

  .site-header__menu summary {
    position: relative;
    z-index: 22;
    display: grid;
    gap: 0.42rem;
    place-content: center;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu summary span {
    display: block;
    width: 1.1rem;
    height: 1px;
    background: currentColor;
    transition:
      transform 280ms var(--ease-out),
      opacity 180ms ease-out;
  }

  .site-header__menu[open] summary span:first-child {
    transform: translateY(0.22rem) rotate(45deg);
  }

  .site-header__menu[open] summary span:last-child {
    transform: translateY(-0.22rem) rotate(-45deg);
  }

  .site-header__menu-panel {
    position: fixed;
    inset: 0;
    z-index: 21;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 7rem var(--gutter) 3rem;
    color: var(--color-graphite);
    background: var(--color-champagne);
  }

  .site-header__menu-panel nav {
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  .site-header__menu-panel nav a {
    padding: 0.72rem 0;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 12vw, 4rem);
    line-height: 1;
    text-decoration: none;
  }

  .site-header__menu-panel nav a[aria-current="page"] {
    color: var(--color-bronze);
  }

  .site-header__menu-panel p {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  @media (min-width: 64rem) {
    .site-header {
      grid-template-columns: 1fr auto 1fr;
      min-height: 6.75rem;
      padding-block: 1.2rem;
    }

    .site-header__desktop-nav {
      display: flex;
      align-items: center;
      gap: clamp(1.5rem, 3vw, 3.2rem);
    }

    .site-header__desktop-nav a {
      position: relative;
      color: var(--color-text-muted);
      font-size: 0.88rem;
      font-weight: 550;
      text-decoration: none;
    }

    .site-header__desktop-nav a::after {
      position: absolute;
      right: 0;
      bottom: -0.5rem;
      left: 0;
      height: 1px;
      content: "";
      background: var(--color-bronze);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 240ms var(--ease-out);
    }

    .site-header__desktop-nav a:hover::after,
    .site-header__desktop-nav a[aria-current="page"]::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .site-header__desktop-cta {
      display: flex;
      justify-content: flex-end;
    }

    .site-header__menu {
      display: none;
    }
  }
</style>
