---
import pages from "../data/pages.json";
import { createWhatsAppUrl } from "../lib/contact";
import { withBase } from "../lib/paths";

interface Props {
  message: string;
  class?: string;
  variant?: "primary" | "secondary" | "text";
  label?: string;
}

const {
  message,
  class: className,
  variant = "primary",
  label = pages.global.defaultWhatsAppCta,
} = Astro.props;
const whatsappUrl = createWhatsAppUrl(message);
const href = whatsappUrl ?? withBase("/#contato");
---

<a
  class:list={["button", `button--${variant}`, className]}
  href={href}
  target={whatsappUrl ? "_blank" : undefined}
  rel={whatsappUrl ? "noopener noreferrer" : undefined}
  data-contact-ready={Boolean(whatsappUrl)}
>
  <span>{label}</span>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19">
    <path
      d="M7.4 18.7 3 20l1.3-4.3A8.7 8.7 0 1 1 7.4 18.7Z"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.6"></path>
    <path
      d="M8.2 7.6c.3-.3.7-.2.9.1l1 1.8c.2.3.1.7-.1.9l-.7.6c.7 1.4 1.8 2.5 3.2 3.2l.7-.8c.2-.2.5-.3.8-.1l1.8.9c.4.2.5.6.3.9-.4.8-1.1 1.3-2 1.3-3.5-.1-6.5-2.9-6.7-6.5 0-.9.3-1.7.8-2.3Z"
      fill="currentColor"></path>
  </svg>
</a>
