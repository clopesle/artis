---
import pages from "../data/pages.json";
import type { CartItem, CartItemType } from "../lib/cart";

interface Props {
  itemType: CartItemType;
  itemId: string;
  name: string;
  detail?: string;
  priceLabel?: string;
  label?: string;
  variant?: "primary" | "secondary";
}

const {
  itemType,
  itemId,
  name,
  detail,
  priceLabel,
  label = pages.global.defaultCartCta,
  variant = "secondary",
} = Astro.props;
const item: CartItem = {
  key: `${itemType}:${itemId}`,
  type: itemType,
  id: itemId,
  name,
  detail,
  priceLabel,
  quantity: 1,
};
---

<button
  type="button"
  class:list={["button", { "button--secondary": variant === "secondary" }]}
  data-cart-add
  data-cart-item={JSON.stringify(item)}
  data-default-label={label}
>
  <span data-cart-button-label>{label}</span>
  <svg aria-hidden="true" viewBox="0 0 24 24">
    <path d="M5 8h14l-1 12H6L5 8Z"></path>
    <path d="M9 9V6a3 3 0 0 1 6 0v3"></path>
  </svg>
</button>

<style>
  button {
    cursor: pointer;
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
</style>
